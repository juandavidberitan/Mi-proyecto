@app.route('/encuentros')
def ver_encuentros():
    try:
        conn = psycopg2.connect(**DB_CONFIG)
        cur = conn.cursor()
        cur.execute("""
            SELECT e.id_encuentro, p.nombre || ' ' || p.apellido_paterno, ev.nombre_evento, e.fecha_encuentro, e.tipo_participacion
            FROM encuentros e
            JOIN personas p ON e.id_persona = p.id_persona
            JOIN eventos ev ON e.id_evento = ev.id_evento
