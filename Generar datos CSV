import csv

print("="*50)
print("Generando datos con IA (simulación)")
print("="*50)

# Generar 100 personas
personas = []
for i in range(1, 101):
    personas.append({
        'carnet_identidad': f"{10000000 + i}-{chr(65 + (i % 26))}",
        'nombre': f'Nombre{i}',
        'apellido_paterno': f'ApellidoP{i}',
        'apellido_materno': f'ApellidoM{i}',
        'fecha_nacimiento': f'{1980 + (i % 20)}-{(i % 12)+1:02d}-{(i % 28)+1:02d}',
        'genero': 'M' if i % 2 == 0 else 'F',
        'direccion': f'Calle {i}, Ciudad',
        'telefono': f'555-{1000+i:04d}',
        'email': f'persona{i}@email.com',
        'fecha_registro': '2025-03-25 10:00:00'
    })

with open('personas.csv', 'w', newline='', encoding='utf-8') as f:
    writer = csv.DictWriter(f, fieldnames=personas[0].keys())
    writer.writeheader()
    writer.writerows(personas)
print(f"✅ personas.csv generado con {len(personas)} registros")

# Generar 20 eventos
eventos = []
tipos = ['Conferencia', 'Taller', 'Seminario', 'Reunión', 'Capacitación']
lugares = ['Centro de Convenciones', 'Universidad Nacional', 'Auditorio Empresarial', 'Hotel Plaza', 'Sala Virtual']

for i in range(1, 21):
    eventos.append({
        'nombre_evento': f'Evento {i} 2025',
        'tipo_evento': tipos[i % len(tipos)],
        'fecha_evento': f'2025-{i%12+1:02d}-{i%28+1:02d}',
        'lugar': lugares[i % len(lugares)],
        'descripcion': f'Descripción del evento {i}',
        'capacidad_maxima': 50 + (i * 10),
        'fecha_creacion': '2025-03-25 09:00:00'
    })

with open('eventos.csv', 'w', newline='', encoding='utf-8') as f:
    writer = csv.DictWriter(f, fieldnames=eventos[0].keys())
    writer.writeheader()
    writer.writerows(eventos)
print(f"✅ eventos.csv generado con {len(eventos)} registros")

# Generar 200 encuentros
import random

# Cargar personas
personas_ids = []
with open('personas.csv', 'r', encoding='utf-8') as f:
    reader = csv.DictReader(f)
    personas_ids = [row['carnet_identidad'] for row in reader]

# Cargar eventos
eventos_nombres = []
with open('eventos.csv', 'r', encoding='utf-8') as f:
    reader = csv.DictReader(f)
    eventos_nombres = [row['nombre_evento'] for row in reader]

tipos_participacion = ['Asistente', 'Ponente', 'Organizador', 'Invitado', 'Staff']
encuentros = []

for i in range(1, 201):
    encuentros.append({
        'carnet_identidad': random.choice(personas_ids),
        'nombre_evento': random.choice(eventos_nombres),
        'fecha_encuentro': f'2025-{(i%12)+1:02d}-{(i%28)+1:02d} 10:00:00',
        'tipo_participacion': random.choice(tipos_participacion),
        'observaciones': ''
    })

with open('encuentros.csv', 'w', newline='', encoding='utf-8') as f:
    writer = csv.DictWriter(f, fieldnames=encuentros[0].keys())
    writer.writeheader()
    writer.writerows(encuentros)
print(f"✅ encuentros.csv generado con {len(encuentros)} registros")

print("\n" + "="*50)
print("✅ GENERACIÓN COMPLETADA")
print("="*50)
